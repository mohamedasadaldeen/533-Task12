@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- Left Content -->
            <div class="col-lg-6">

                <span class="hero-badge">
                    <i class="bi bi-stars me-2"></i>
                    YOUR DAILY PRODUCTIVITY PARTNER
                </span>

                <h1 class="hero-title mt-4">
                    Organize Your Tasks.
                    <span>Achieve More.</span>
                </h1>

                <p class="hero-description mt-4">
                    Take control of your day with ToDoListApp.
                    Organize your tasks, manage your time, and
                    turn your plans into achievements.
                </p>

                <div class="d-flex flex-wrap gap-3 mt-4">

                    <a asp-controller="Task"
                       asp-action="Index"
                       class="btn btn-primary btn-lg hero-btn">

                        <i class="bi bi-list-check me-2"></i>
                        View Tasks
                    </a>

                    <a asp-controller="Task"
                       asp-action="Create"
                       class="btn btn-outline-primary btn-lg hero-btn">

                        <i class="bi bi-plus-circle me-2"></i>
                        Add New Task

                    </a>

                </div>

                <!-- Features -->
                <div class="row g-3 mt-4">

                    <div class="col-sm-4">
                        <div class="feature-item">
                            <i class="bi bi-check-circle-fill"></i>
                            <h6>Stay Organized</h6>
                            <small>Manage your tasks</small>
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="feature-item">
                            <i class="bi bi-clock-fill"></i>
                            <h6>Save Time</h6>
                            <small>Focus on priorities</small>
                        </div>
                    </div>

                    <div class="col-sm-4">
                        <div class="feature-item">
                            <i class="bi bi-bullseye"></i>
                            <h6>Reach Goals</h6>
                            <small>Make progress daily</small>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Image -->
            <div class="col-lg-6">

                <div class="hero-image-wrapper">

                    <img src="~/images/todo-hero.png"
                         asp-append-version="true"
                         alt="Organize your daily tasks"
                         class="hero-image" />

                    <div class="floating-card">
                        <div class="floating-icon">
                            <i class="bi bi-check2-all"></i>
                        </div>

                        <div>
                            <h6 class="mb-1">Stay on track!</h6>
                            <small>Your goals start here.</small>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>
</section>

@section Styles {
    <style>
        .hero-section {
            padding: 70px 0;
            background:
                radial-gradient(
                    circle at 85% 20%,
                    #dbeafe 0,
                    transparent 35%
                ),
                linear-gradient(135deg, #ffffff, #f1f7ff);
        }

        .hero-badge {
            display: inline-block;
            padding: 10px 16px;
            border-radius: 30px;
            background-color: #dbeafe;
            color: #1d4ed8;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .hero-title {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 800;
            line-height: 1.2;
            color: #172554;
        }

        .hero-title span {
            display: block;
            color: #2563eb;
        }

        .hero-description {
            max-width: 530px;
            font-size: 1.1rem;
            line-height: 1.9;
            color: #64748b;
        }

        .hero-btn {
            padding: 13px 22px;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            transition: 0.25s;
        }

        .hero-btn:hover {
            transform: translateY(-3px);
        }

        .hero-image-wrapper {
            position: relative;
            padding: 15px;
        }

        .hero-image {
            display: block;
            width: 100%;
            height: auto;
            object-fit: contain;
            border-radius: 24px;
        }

        .floating-card {
            position: absolute;
            bottom: 0;
            left: 0;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 20px;
            background: rgba(255, 255, 255, 0.96);
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 12px 35px rgba(30, 64, 175, 0.12);
        }

        .floating-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 45px;
            height: 45px;
            border-radius: 12px;
            background-color: #dcfce7;
            color: #16a34a;
            font-size: 1.5rem;
        }

        .floating-card h6 {
            color: #1e293b;
            font-weight: 700;
        }

        .floating-card small {
            color: #64748b;
        }

        .feature-item {
            height: 100%;
            padding: 12px 0;
        }

        .feature-item > i {
            display: inline-block;
            margin-bottom: 10px;
            color: #2563eb;
            font-size: 1.6rem;
        }

        .feature-item h6 {
            margin-bottom: 5px;
            color: #1e293b;
            font-weight: 700;
        }

        .feature-item small {
            color: #64748b;
        }

        @@media (max-width: 991.98px) {
            .hero-section {
                padding: 45px 0;
            }

            .hero-image-wrapper {
                max-width: 650px;
                margin: 0 auto;
            }
        }

        @@media (max-width: 575.98px) {
            .hero-title {
                font-size: 2.5rem;
            }

            .hero-btn {
                width: 100%;
            }

            .floating-card {
                bottom: -5px;
                left: 5px;
                padding: 12px;
            }
        }
    </style>
}
